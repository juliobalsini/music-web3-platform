# Copie para .env.local e preencha. Nunca commite .env.local.

# Supabase (públicas — vão para o browser)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública: legada "anon" ou nova "publishable" (sb_publishable_...).
# Alternativa: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (tem prioridade se definida).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SOMENTE servidor)
# Chave admin: legada "service_role" ou nova "secret" (sb_secret_...).
# Alternativa: SUPABASE_SECRET_KEY (tem prioridade se definida).
SUPABASE_SERVICE_ROLE_KEY=

# Usadas apenas pelo Supabase CLI (link / db push)
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=
