{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$GITHUB_ACTIONS\" ] || bash \"$CLAUDE_PROJECT_DIR/scripts/notify.sh\" hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(*impeccable/scripts/impeccable*)"
    ]
  }
}
